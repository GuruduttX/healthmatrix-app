{
  "expo": {
    "name": "HealthMatrix",
    "slug": "health-matrix",
    "owner": "inventoappss-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "healthmatrix",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.inventoapps.healthmatrix",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0E2A33",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#F8F5F0"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F5F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#DD4301"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HealthMatrix uses your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "HealthMatrix uses your photos so you can choose a profile picture.",
          "savePhotosPermission": "HealthMatrix saves your emergency QR picture to Photos so you can set it as your Lock Screen.",
          "granularPermissions": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.twilio.** { *; }\n-keep class com.twiliorn.** { *; }\n-keep class tvi.webrtc.** { *; }",
            "buildArchs": ["armeabi-v7a", "arm64-v8a"]
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HealthMatrix uses your camera so your doctor can see you during a video consult.",
          "microphonePermission": "HealthMatrix uses your microphone so your doctor can hear you during a video consult, and so you can ask Ekaay questions by voice.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "HealthMatrix uses your microphone so your doctor can hear you during a video consult, and so you can ask Ekaay questions by voice.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F8F5F0",
    "extra": {
      "eas": {
        "projectId": "798aaf34-6b6d-4412-9b7f-eae462bc2e0c"
      }
    },
    "ios": {
      "bundleIdentifier": "com.inventoapps.healthmatrix",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    }
  }
}
