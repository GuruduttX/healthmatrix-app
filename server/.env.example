# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local:         mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=healthmatrix

# Comma-separated origins allowed to call the API from a browser (Expo web).
CORS_ORIGINS=http://localhost:8081

# Base URL printed inside emergency QR codes, e.g. https://cloudspital.ai/e
EMERGENCY_BASE_URL=http://localhost:4000/e
